+    """Extract into game_dir without overwriting loose files (Ren'Py prefers loose
+    files over archives, so the result is equivalent). On error, remove what was
+    written and raise. Returns the written paths."""
+    destination = LN_src_tools_game_optimizer__Path(game_dir).resolve()
+    written = []
+    try:
+        entries = LN_src_tools_game_optimizer__read_rpa_index(rpa)
+        with open(rpa, 'rb') as f:
