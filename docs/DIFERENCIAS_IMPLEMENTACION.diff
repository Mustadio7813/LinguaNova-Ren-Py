+# ── estimate ───────────────────────────────────────────────────────────────
+def LN_src_tools_game_optimizer___sample(items, n):
+    items = sorted(items, key=lambda x: x[1])
+    if len(items) <= n:
+        return items
+    step = len(items) / n
+    return [items[int(i * step)] for i in range(n)]
+
+
+def LN_src_tools_game_optimizer__estimate(game_dir, level='equilibrada', windows_only=False, old_pc=False, cancel_event=None, report=None,
+                 ffmpeg=None, workers=None):
+    """Compress a sample in a temporary folder. Nothing in the game is written.
+    Returns a dict with 'rows' [(section, current, estimated)], 'engine', 'original'."""
+    cancel_event = cancel_event or LN_src_tools_game_optimizer__threading.Event()
+    report = report or (lambda stage, done, total: None)
+    cfg = LN_src_tools_game_optimizer__LEVELS[level]
+    cfg_video = cfg['video'] or (LN_src_tools_game_optimizer__LEVELS['equilibrada']['video'] if old_pc else None)
+    workers = workers or min(LN_src_tools_game_optimizer__os.cpu_count() or 2, 6)
+    root, game = LN_src_tools_game_optimizer__game_paths(game_dir)
+    ffmpeg = ffmpeg if ffmpeg is not None else LN_src_tools_game_optimizer__find_ffmpeg()
+    original_size = LN_src_tools_game_optimizer__folder_size(root)
+    missing = LN_src_tools_game_optimizer__missing_image_libraries()
+    inventory = {'images': [], 'audio': [], 'video': []}
+
+    def group(ext):
+        return 'images' if ext in LN_src_tools_game_optimizer__EXT_IMAGE else 'audio' if ext in LN_src_tools_game_optimizer__EXT_AUDIO else \
+            'video' if ext in LN_src_tools_game_optimizer__EXT_VIDEO else None
+
+    for p in game.rglob('*'):
+        if p.is_file() and group(p.suffix.lower()):
+            inventory[group(p.suffix.lower())].append((p.name, p.stat().st_size, p))
+    unreadable = []
+    for rpa in LN_src_tools_game_optimizer__list_rpas(game):
+        try:
+            for name, off, length, prefix in LN_src_tools_game_optimizer__read_rpa_index(rpa):
+                g = group(LN_src_tools_game_optimizer__Path(name).suffix.lower())
+                if g:
+                    inventory[g].append((LN_src_tools_game_optimizer__Path(name).name, length, (rpa, off, length, prefix)))
+        except Exception as e:
+            unreadable.append(f'{rpa.name}: {e}')
+
+    rows = []
+    with LN_src_tools_game_optimizer__tempfile.TemporaryDirectory(prefix='linguanova_estimar_') as tmp:
+        tmp = LN_src_tools_game_optimizer__Path(tmp)
+
+        def materialise(i, item):
+            name, _size, source = item
+            target = tmp / f'{i:04d}_{name}'
+            if isinstance(source, LN_src_tools_game_optimizer__Path):
+                LN_src_tools_game_optimizer__shutil.copy2(source, target)
+            else:
+                rpa, off, length, prefix = source
+                with open(rpa, 'rb') as f:
+                    LN_src_tools_game_optimizer__copy_entry(f, off, length, prefix, target)
+            return target
+
+        def measure(key, n, function, extra, processes, count):
+            items = inventory[key]
+            total = sum(x[1] for x in items)
+            if not items:
+                return total, total
+            sample = LN_src_tools_game_optimizer___sample(items, n)
+            paths = [materialise(i, it) for i, it in enumerate(sample)]
+            o, f, _notes = LN_src_tools_game_optimizer__run_batch(key, paths, function, extra, count, cancel_event, report, processes=processes)
+            for x in paths:
+                x.unlink(missing_ok=True)
+            ratio = f / o if o else 1
+            return total, int(total * ratio)
+
+        if 'Pillow' not in missing:
+            o, f = measure('images', 40, LN_src_tools_game_optimizer__optimize_image, (cfg,), True, min(workers, 4))
+            rows.append(('images', o, f))
+        if ffmpeg:
+            o, f = measure('audio', 15, LN_src_tools_game_optimizer__optimize_audio,
+                            (ffmpeg, cfg['audio'], LN_src_tools_game_optimizer__engine_accepts_opus(root), cancel_event), False, workers)
+            rows.append(('audio', o, f))
+            if cfg_video and inventory['video']:
+                items = inventory['video']
+                total = sum(x[1] for x in items)
+                oo = ff = 0
+                sample = LN_src_tools_game_optimizer___sample(items, 2)
+                for i, it in enumerate(sample):
+                    report('video', i, len(sample))
+                    if cancel_event.is_set():
+                        raise LN_src_tools_game_optimizer__Cancelled()
+                    whole = materialise(100 + i, it)
+                    part = whole.with_name('seg_' + whole.name)
+                    try:
+                        LN_src_tools_game_optimizer__run_ffmpeg(ffmpeg, ['-i', str(whole), '-t', '20', '-c', 'copy', str(part)], cancel_event)
+                        whole.unlink()
+                        _, a, b, _ = LN_src_tools_game_optimizer__optimize_video(part, ffmpeg, cfg_video, old_pc=old_pc, cancel_event=cancel_event)
+                        oo += a
+                        ff += b
+                    except LN_src_tools_game_optimizer__Cancelled:
+                        raise
+                    except Exception:
+                        pass
+                    finally:
+                        whole.unlink(missing_ok=True)
+                        part.unlink(missing_ok=True)
+                report('video', len(sample), len(sample))
+                rows.append(('video', total, int(total * (ff / oo)) if oo else total))
+    engine = 0
+    if windows_only:
+        engine = sum(LN_src_tools_game_optimizer__folder_size(p) if p.is_dir() else p.stat().st_size for p in LN_src_tools_game_optimizer__non_windows_items(root))
+    saving = sum(o - f for _, o, f in rows) + engine
+    return dict(rows=rows, engine=engine, original=original_size, estimated=max(0, original_size - saving),
+                ffmpeg=bool(ffmpeg), missing_libraries=missing, unreadable=unreadable, level=level)
