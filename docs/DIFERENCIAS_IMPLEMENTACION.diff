+# ── compress ───────────────────────────────────────────────────────────────
+def LN_src_tools_game_optimizer__compress(game_dir, output, level='equilibrada', windows_only=False, low_ram=False, old_pc=False,
+                 cancel_event=None, report=None, ffmpeg=None, workers=None):
+    """Create the lighter copy. Returns a dict with sizes, notes and the report path.
+
+    report(stage, done, total) receives: 'copy', 'rpa', 'engine', 'images',
+    'audio', 'video' and 'final'. Raises LN_src_tools_game_optimizer__Cancelled or LN_src_tools_game_optimizer__OptimizerError.
+    The copy is built in '<output>.parcial' and only replaces an earlier copy at
+    the very end, so stopping or failing never loses a previous good copy.
+    """
+    cancel_event = cancel_event or LN_src_tools_game_optimizer__threading.Event()
+    report = report or (lambda stage, done, total: None)
+    cfg = LN_src_tools_game_optimizer__LEVELS[level]
+    cfg_video = cfg['video'] or (LN_src_tools_game_optimizer__LEVELS['equilibrada']['video'] if old_pc else None)
+    workers = workers or min(LN_src_tools_game_optimizer__os.cpu_count() or 2, 6)
+    started = LN_src_tools_game_optimizer__time.time()
+    root, game = LN_src_tools_game_optimizer__game_paths(game_dir)
+    output = LN_src_tools_game_optimizer__Path(output).resolve()
+    staging = output.with_name(output.name + '.parcial')
+    problem = LN_src_tools_game_optimizer__output_problem(output, root) or LN_src_tools_game_optimizer__output_problem(staging, root)
+    if problem:
+        raise LN_src_tools_game_optimizer__OptimizerError(problem)
+    original_size = LN_src_tools_game_optimizer__folder_size(root)
+    free = LN_src_tools_game_optimizer__shutil.disk_usage(output.parent if output.parent.exists() else root).free
+    if free < original_size * 1.3:
+        raise LN_src_tools_game_optimizer__OptimizerError(f'Poco espacio libre: hay {LN_src_tools_game_optimizer__size_text(free)} y se necesitan unos '
+                                 f'{LN_src_tools_game_optimizer__size_text(original_size * 1.3)}.')
+    ffmpeg = ffmpeg if ffmpeg is not None else LN_src_tools_game_optimizer__find_ffmpeg()
+    result = dict(output=str(output), level=level, original=original_size, final=0, sections={},
+                  engine_removed=0, kept_rpa=[], notes=[], ffmpeg=bool(ffmpeg), old_pc=old_pc,
+                  low_ram=low_ram, opus=True, missing_libraries=LN_src_tools_game_optimizer__missing_image_libraries())
+    if staging.exists():
+        LN_src_tools_game_optimizer__shutil.rmtree(staging)
+    staging.mkdir(parents=True)
+    (staging / LN_src_tools_game_optimizer__BUILD_MARK).write_text(f'Copia generada por LinguaNova (optimizador {LN_src_tools_game_optimizer__VERSION})\n',
+                                          encoding='utf-8')
+    try:
+        # 1. Clean copy (no .rpa, no saves/cache, no logs, no LinguaNova backups)
+        root_r, game_r = root.resolve(), game.resolve()
+        total_files = sum(1 for p in root.rglob('*') if p.is_file())
+        copied = 0
+
+        def ignore(current, names):
+            d = LN_src_tools_game_optimizer__Path(current).resolve()
+            out = set()
+            for n in names:
+                nl = n.lower()
+                if d == root_r and (nl in LN_src_tools_game_optimizer__ROOT_JUNK or n in LN_src_tools_game_optimizer__ROOT_SKIP):
+                    out.add(n)
+                elif d == game_r and nl in LN_src_tools_game_optimizer__GAME_JUNK:
+                    out.add(n)
+                elif nl.endswith('.rpa') and (d == game_r or game_r in d.parents):
+                    out.add(n)
+            return out
+
+        def copy_file(src, dst):
+            nonlocal copied
+            if cancel_event.is_set():
+                raise LN_src_tools_game_optimizer__Cancelled()
+            LN_src_tools_game_optimizer__shutil.copy2(src, dst)
+            copied += 1
+            if copied % 25 == 0:
+                report('copy', copied, total_files)
+
+        report('copy', 0, total_files)
+        try:
+            LN_src_tools_game_optimizer__shutil.copytree(root, staging, ignore=ignore, copy_function=copy_file, dirs_exist_ok=True)
+        except LN_src_tools_game_optimizer__shutil.Error as e:
+            if cancel_event.is_set():
+                raise LN_src_tools_game_optimizer__Cancelled()
+            raise LN_src_tools_game_optimizer__OptimizerError(f'No se pudo copiar el juego: {str(e)[:300]}')
+        report('copy', total_files, total_files)
+        game_out = staging / game.relative_to(root)
+
+        # 2. Extract .rpa inside the copy
+        rpas = LN_src_tools_game_optimizer__list_rpas(game)
+        for i, rpa in enumerate(rpas):
+            report('rpa', i, len(rpas))
+            try:
+                LN_src_tools_game_optimizer__extract_rpa(rpa, game_out, cancel_event.is_set)
+            except LN_src_tools_game_optimizer__Cancelled:
+                raise
+            except Exception as e:
+                target = game_out / rpa.relative_to(game)
+                target.parent.mkdir(parents=True, exist_ok=True)
+                LN_src_tools_game_optimizer__shutil.copy2(rpa, target)
+                result['kept_rpa'].append(f'{rpa.name} ({e})')
+        report('rpa', len(rpas), len(rpas))
+
+        # 3. Engine
+        if windows_only:
+            items = LN_src_tools_game_optimizer__non_windows_items(staging)
+            for i, p in enumerate(items):
+                report('engine', i, len(items))
+                size = LN_src_tools_game_optimizer__folder_size(p) if p.is_dir() else p.stat().st_size
+                LN_src_tools_game_optimizer__shutil.rmtree(p) if p.is_dir() else p.unlink()
+                result['engine_removed'] += size
+            report('engine', len(items), len(items))
+
+        # 4. Media
+        opus_ok = LN_src_tools_game_optimizer__engine_accepts_opus(root)
+        result['opus'] = opus_ok
+        if 'Pillow' not in result['missing_libraries']:
+            o, f, n = LN_src_tools_game_optimizer__run_batch('images', LN_src_tools_game_optimizer__list_files(game_out, LN_src_tools_game_optimizer__EXT_IMAGE), LN_src_tools_game_optimizer__optimize_image, (cfg,),
+                                    min(workers, 4), cancel_event, report, processes=True, base=game_out)
+            result['sections']['images'] = (o, f)
+            result['notes'] += n
+        if ffmpeg:
+            o, f, n = LN_src_tools_game_optimizer__run_batch('audio', LN_src_tools_game_optimizer__list_files(game_out, LN_src_tools_game_optimizer__EXT_AUDIO), LN_src_tools_game_optimizer__optimize_audio,
+                                    (ffmpeg, cfg['audio'], opus_ok, cancel_event), workers, cancel_event, report,
+                                    base=game_out)
+            result['sections']['audio'] = (o, f)
+            result['notes'] += n
+            if cfg_video:
+                o, f, n = LN_src_tools_game_optimizer__run_batch('video', LN_src_tools_game_optimizer__list_files(game_out, LN_src_tools_game_optimizer__EXT_VIDEO), LN_src_tools_game_optimizer__optimize_video,
+                                        (ffmpeg, cfg_video, None, old_pc, cancel_event), 1, cancel_event, report,
+                                        base=game_out)
+                result['sections']['video'] = (o, f)
+                result['notes'] += n
+
+        # 5. Final touches
+        report('final', 0, 1)
+        if low_ram:
+            (game_out / 'zz_gama_baja.rpy').write_text(LN_src_tools_game_optimizer__LOW_RAM_TEMPLATE, encoding='utf-8')
+        for t in game_out.rglob('*.tmp_*'):
+            t.unlink(missing_ok=True)
+        if output.exists():
+            LN_src_tools_game_optimizer__shutil.rmtree(output)
+        LN_src_tools_game_optimizer__os.replace(staging, output)
+        result['final'] = LN_src_tools_game_optimizer__folder_size(output)
+        result['seconds'] = LN_src_tools_game_optimizer__time.time() - started
+        report('final', 1, 1)
+        return result
+    except BaseException:
+        LN_src_tools_game_optimizer__shutil.rmtree(staging, ignore_errors=True)
+        raise
+
