+def LN_src_tools_game_optimizer__optimize_audio(path, ffmpeg, mode, opus_ok=True, cancel_event=None):
+    """mode: 'sin_perdida', 'equilibrada' or 'maxima'. The extension never changes.
+    opus_ok=False (old engines): .ogg files are recompressed as Vorbis, not Opus."""
+    path = LN_src_tools_game_optimizer__Path(path)
+    orig = path.stat().st_size
+    try:
+        info = LN_src_tools_game_optimizer__probe(ffmpeg, path)
+        if not info['acodec']:
+            return str(path), orig, orig, 'sin pista de audio'
+        ext = path.suffix.lower()
+        channels = info['canales'] or 2
+        br = info['abitrate']
+        base = ['-i', str(path), '-map', '0:a:0', '-map_metadata', '-1', '-vn']
+        copy = ['-c:a', 'copy']
+        c = None
+        if ext in ('.ogg', '.opus'):
+            if mode == 'sin_perdida' or channels > 2:
+                c = copy
+            elif not opus_ok and info['acodec'] != 'opus':
+                c = ['-c:a', 'libvorbis', '-q:a', '4' if mode == 'equilibrada' else '2']
+            elif not opus_ok:
+                c = copy  # already Opus: left alone
+            else:
+                per_channel = 48 if mode == 'equilibrada' else 32
+                target = per_channel * channels
+                if info['acodec'] == 'opus' and br and br <= target * 1.15:
+                    c = copy
+                else:
+                    c = ['-c:a', 'libopus', '-b:a', f'{target}k', '-vbr', 'on', '-application', 'audio', '-f', 'ogg']
+        elif ext == '.mp3':
+            limit, quality = {'equilibrada': (180, 4), 'maxima': (130, 6)}.get(mode, (None, None))
+            c = ['-c:a', 'libmp3lame', '-q:a', str(quality)] if limit and br and br > limit else copy
+            c = c + ['-id3v2_version', '0', '-write_id3v1', '0']
+        elif ext == '.m4a':
+            c = ['-c:a', 'aac', '-b:a', '112k'] if mode == 'maxima' and br and br > 128 else copy
+        elif ext == '.flac':
+            c = ['-c:a', 'flac', '-compression_level', '12']
+        elif ext == '.wav':
+            if mode != 'sin_perdida' and info['acodec'] in LN_src_tools_game_optimizer__PCM_HIGH:
+                c = ['-c:a', 'pcm_s16le']  # 24/32 bits -> 16 bits: inaudible in a game
+            else:
+                return str(path), orig, orig, ''
+        if c is None:
+            return str(path), orig, orig, ''
+        tmp = path.with_name(path.stem + '.tmp_opt' + path.suffix)
+        LN_src_tools_game_optimizer__run_ffmpeg(ffmpeg, base + c + [str(tmp)], cancel_event)
+        final, note = LN_src_tools_game_optimizer__accept_if_valid(ffmpeg, path, tmp, info['duracion'])
+        return str(path), orig, final, note
+    except LN_src_tools_game_optimizer__Cancelled:
+        raise
+    except Exception as e:
+        return str(path), orig, orig, f'error: {e}'
+
+
+# ── video ──────────────────────────────────────────────────────────────────
+def LN_src_tools_game_optimizer__optimize_video(path, ffmpeg, cfg_video, max_height=None, old_pc=False, cancel_event=None):
+    """Normal: re-encode with the SAME codec the video had.
+    old_pc=True: also 720p, at most 30 fps and VP9/AV1 -> VP8 or H.264, much
+    lighter to decode. Then the result is accepted even when bigger."""
+    path = LN_src_tools_game_optimizer__Path(path)
+    orig = path.stat().st_size
+    try:
+        info = LN_src_tools_game_optimizer__probe(ffmpeg, path)
+        vc = info['vcodec']
+        if not vc:
+            return str(path), orig, orig, 'sin pista de video'
+        if info['alpha']:
+            return str(path), orig, orig, 'tiene transparencia, no se toca'
+        ext = path.suffix.lower()
+        filters = []
+        lighter = False
+        if old_pc:
+            max_height = min(max_height or LN_src_tools_game_optimizer__OLD_PC_HEIGHT, LN_src_tools_game_optimizer__OLD_PC_HEIGHT)
+        if max_height and info['alto'] and info['alto'] > max_height:
+            filters.append(f'scale=-2:{max_height}')
+            lighter = True
+        if old_pc and info['fps'] and info['fps'] > LN_src_tools_game_optimizer__OLD_PC_FPS + 1:
+            filters.append(f'fps={LN_src_tools_game_optimizer__OLD_PC_FPS}')
+            lighter = True
+        if old_pc and vc in ('vp9', 'av1'):
+            if ext in ('.webm', '.mkv'):
+                vc = 'vp8'
+            elif ext in ('.mp4', '.m4v', '.mov'):
+                vc = 'h264'
+            lighter = lighter or vc in ('vp8', 'h264')
+        filter_args = ['-vf', ','.join(filters)] if filters else []
+        if vc == 'h264':
+            c = ['-c:v', 'libx264', '-preset', cfg_video['preset'], '-crf', str(cfg_video['h264']), '-pix_fmt', 'yuv420p']
+            if ext in ('.mp4', '.m4v', '.mov'):
+                c += ['-movflags', '+faststart']
+        elif vc == 'vp9':
+            c = ['-c:v', 'libvpx-vp9', '-crf', str(cfg_video['vp9']), '-b:v', '0', '-row-mt', '1',
+                 '-deadline', 'good', '-cpu-used', str(cfg_video['cpu_used']), '-pix_fmt', 'yuv420p']
+        elif vc == 'vp8':
+            # libvpx (VP8) ignores -crf when -b:v is 0. A bitrate cap is needed: the
+            # one the video already had (so it does not grow) and -crf sets quality.
+            dur = info['duracion']
+            kbps = int(orig * 8 / dur / 1000) if dur else 8000
+            if lighter:
+                kbps = int(kbps * 1.5)
+            c = ['-c:v', 'libvpx', '-crf', str(cfg_video['vp8']), '-b:v', f'{max(kbps, 300)}k',
+                 '-deadline', 'good', '-cpu-used', str(cfg_video['cpu_used']), '-auto-alt-ref', '1', '-lag-in-frames', '16']
+        elif vc == 'theora':
+            c = ['-c:v', 'libtheora', '-q:v', str(cfg_video['theora'])]
+        else:
+            return str(path), orig, orig, f'códec {vc}: se deja igual'
+        tmp = path.with_name(path.stem + '.tmp_opt' + path.suffix)
+        LN_src_tools_game_optimizer__run_ffmpeg(ffmpeg, ['-i', str(path), '-map', '0:v:0', '-map', '0:a?', '-map_metadata', '-1']
+                       + filter_args + c + ['-c:a', 'copy', str(tmp)], cancel_event)
+        final, note = LN_src_tools_game_optimizer__accept_if_valid(ffmpeg, path, tmp, info['duracion'], min_saving=0.05, even_if_bigger=lighter)
+        return str(path), orig, final, note
+    except LN_src_tools_game_optimizer__Cancelled:
+        raise
+    except Exception as e:
+        return str(path), orig, orig, f'error: {e}'
+
+
+# ── batches ────────────────────────────────────────────────────────────────
+def LN_src_tools_game_optimizer__list_files(folder, extensions):
+    return [p for p in LN_src_tools_game_optimizer__Path(folder).rglob('*')
+            if p.is_file() and p.suffix.lower() in extensions and '.tmp_' not in p.name]
