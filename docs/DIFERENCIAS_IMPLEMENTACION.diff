+def LN_src_tools_game_optimizer__safe_path(destination, name):
+    if name.startswith(('/', '\\')) or LN_src_tools_game_optimizer__re.match(r'^[A-Za-z]:', name):
+        raise ValueError(f'ruta absoluta en el archivo: {name}')
+    out = (destination / name.replace('\\', '/')).resolve()
+    out.relative_to(destination)  # ValueError when it tries to leave the folder
