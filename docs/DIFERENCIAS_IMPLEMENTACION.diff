+# ── destination ────────────────────────────────────────────────────────────
+def LN_src_tools_game_optimizer__output_problem(output, root):
+    output, root = LN_src_tools_game_optimizer__Path(output).resolve(), LN_src_tools_game_optimizer__Path(root).resolve()
+    if output == root or root in output.parents or output in root.parents:
+        return 'La carpeta de destino no puede ser el juego, estar dentro de él ni contenerlo.'
+    if output.exists():
+        if not output.is_dir():
+            return 'La ruta de destino existe y es un archivo.'
+        if any(output.iterdir()) and not (output / LN_src_tools_game_optimizer__BUILD_MARK).exists():
+            return ('La carpeta de destino ya existe y tiene archivos que no son de una copia anterior. '
+                    'Por seguridad no se borra: elige otra carpeta.')
+    return None
+
