+def LN_src_tools_game_optimizer__process_pool(workers):
+    """Worker processes started with 'spawn' (the only mode on Windows)."""
+    return LN_src_tools_game_optimizer__ProcessPoolExecutor(max_workers=workers, mp_context=LN_src_tools_game_optimizer__multiprocessing.get_context('spawn'))
+
+
+def LN_src_tools_game_optimizer__run_batch(stage, files, function, extra, workers, cancel_event, report, processes=False, base=None):
+    """Run function over files; report(stage, done, total). Returns (orig, final, notes)."""
+    total = len(files)
+    done = orig_total = final_total = 0
+    notes = []
+    if not files:
+        return 0, 0, notes
+    report(stage, 0, total)
+
+    def collect(result):
+        nonlocal done, orig_total, final_total
+        path, o, f, note = result
+        done += 1
+        orig_total += o
+        final_total += f
+        if note.startswith('error') or 'duración' in note:
+            rel = LN_src_tools_game_optimizer__Path(path).relative_to(base) if base else LN_src_tools_game_optimizer__Path(path).name
+            notes.append(f'{rel}: {note}')
+        report(stage, done, total)
+
+    if processes:
+        finished = set()
+        try:
+            with LN_src_tools_game_optimizer__process_pool(max(1, workers)) as ex:
+                futures = {ex.submit(function, str(a), *extra): a for a in files}
+                try:
+                    for fu in LN_src_tools_game_optimizer__as_completed(futures):
+                        if cancel_event.is_set():
+                            raise LN_src_tools_game_optimizer__Cancelled()
+                        collect(fu.result())
+                        finished.add(futures[fu])
+                except BaseException:
+                    ex.shutdown(wait=True, cancel_futures=True)
+                    raise
+            return orig_total, final_total, notes
+        except (LN_src_tools_game_optimizer__BrokenProcessPool, OSError, RuntimeError):
+            # Processes unavailable here: same work with threads.
+            files = [a for a in files if a not in finished]
+    with LN_src_tools_game_optimizer__ThreadPoolExecutor(max_workers=max(1, workers)) as ex:
+        futures = [ex.submit(function, str(a), *extra) for a in files]
+        try:
+            for fu in LN_src_tools_game_optimizer__as_completed(futures):
+                if cancel_event.is_set():
+                    raise LN_src_tools_game_optimizer__Cancelled()
+                collect(fu.result())
+        except BaseException:
+            for fu in futures:
+                fu.cancel()
+            raise
+    return orig_total, final_total, notes
+
+
+# ── engine files for other systems ─────────────────────────────────────────
+def LN_src_tools_game_optimizer__non_windows_items(root):
+    """lib/ folders and root files that are only used on Linux or Mac."""
+    root = LN_src_tools_game_optimizer__Path(root)
+    found = []
+    lib = root / 'lib'
+    if lib.is_dir():
+        for d in lib.iterdir():
+            n = d.name.lower()
+            if d.is_dir() and any(x in n for x in ('linux', 'mac', 'darwin')) and 'python' not in n:
+                found.append(d)
+    for p in root.iterdir():
+        if p.suffix.lower() == '.sh' and p.is_file():
+            found.append(p)
+        if p.suffix.lower() == '.app' and p.is_dir():
+            found.append(p)
+    return found
+
