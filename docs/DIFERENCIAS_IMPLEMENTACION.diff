+                    candidates.append(b.getvalue())
+            if oxipng is not None:
+                # A palette version already far smaller: no need to optimise the original too.
+                if len(candidates) > 1 and len(candidates[1]) < len(candidates[0]) * 0.6:
+                    candidates = candidates[1:]
+                optimised = []
+                for c in candidates:
+                    try:
+                        optimised.append(oxipng.optimize_from_memory(
+                            c, level=cfg['oxipng_nivel'], strip=oxipng.StripChunks.safe(), optimize_alpha=True))
+                    except Exception:
+                        optimised.append(c)
+                candidates = optimised
+            best = min(candidates, key=len)
+            return str(path), orig, LN_src_tools_game_optimizer__replace_if_smaller(path, best), ''
+
+        if ext in ('.jpg', '.jpeg'):
+            best = data
+            if cfg['jpg_calidad']:
+                with Image.open(LN_src_tools_game_optimizer__io.BytesIO(data)) as im:
+                    if im.mode in ('RGB', 'L'):
+                        b = LN_src_tools_game_optimizer__io.BytesIO()
+                        im.save(b, 'JPEG', quality=cfg['jpg_calidad'], optimize=True, progressive=True,
+                                subsampling='keep')
+                        if len(b.getvalue()) <= len(data) * (1 - cfg['jpg_ahorro_min']):
+                            best = b.getvalue()
+            try:
+                import mozjpeg_lossless_optimization as mz
+                best = min((best, mz.optimize(best)), key=len)
+            except ImportError:
+                pass
+            except Exception:
+                pass
+            return str(path), orig, LN_src_tools_game_optimizer__replace_if_smaller(path, best), ''
+
+        if ext == '.webp':
+            kind = LN_src_tools_game_optimizer__webp_kind(data)
+            if kind in (None, 'animada'):
+                return str(path), orig, orig, kind or 'desconocida'
+            with Image.open(LN_src_tools_game_optimizer__io.BytesIO(data)) as im:
+                im.load()
+                b = LN_src_tools_game_optimizer__io.BytesIO()
+                if kind == 'lossless':
+                    im.save(b, 'WEBP', lossless=True, quality=100, method=6, exact=False)
+                    return str(path), orig, LN_src_tools_game_optimizer__replace_if_smaller(path, b.getvalue()), ''
+                if cfg['webp_calidad']:
+                    im.save(b, 'WEBP', quality=cfg['webp_calidad'], method=6)
+                    return str(path), orig, LN_src_tools_game_optimizer__replace_if_smaller(path, b.getvalue(), cfg['webp_ahorro_min']), ''
+            return str(path), orig, orig, ''
+
+        return str(path), orig, orig, 'formato no tratado'
+    except Exception as e:
+        return str(path), orig, orig, f'error: {e}'
+
+
+# ── audio ──────────────────────────────────────────────────────────────────
+def LN_src_tools_game_optimizer__engine_accepts_opus(root):
+    """Opus in .ogg is documented by current Ren'Py; 6.x documentation only lists
+    Vorbis, MP3 and WAV. To be safe, Opus is used only with Python 3 engines (8+)."""
+    lib = LN_src_tools_game_optimizer__Path(root) / 'lib'
+    if lib.is_dir():
+        return any(d.is_dir() and d.name.lower().startswith('py3') for d in lib.iterdir())
+    try:
+        txt = (LN_src_tools_game_optimizer__Path(root) / 'renpy' / '__init__.py').read_text(encoding='utf-8', errors='replace')
+        m = LN_src_tools_game_optimizer__re.search(r'version_tuple\s*=\s*\(\s*(\d+)', txt)
+        if m:
+            return int(m[1]) >= 8
+    except OSError:
+        pass
+    return True
+
