+def LN_src_tools_game_optimizer__accept_if_valid(ffmpeg, original, candidate, original_duration, min_saving=0.0, even_if_bigger=False):
+    """Replace original with candidate when it lasts the same and is smaller
+    (or, with even_if_bigger, also when bigger: old-PC video mode)."""
+    orig = original.stat().st_size
+    try:
+        if not candidate.is_file():
+            return orig, 'sin salida'
+        new = candidate.stat().st_size
+        if new == 0 or (not even_if_bigger and new >= orig * (1 - min_saving)):
+            return orig, 'no mejora'
+        if original_duration:
+            d = LN_src_tools_game_optimizer__probe(ffmpeg, candidate)['duracion']
+            if d is None or abs(d - original_duration) > max(0.5, original_duration * 0.01):
+                return orig, 'duración distinta, se conserva el original'
+        LN_src_tools_game_optimizer__os.replace(candidate, original)
+        return new, ''
+    finally:
+        candidate.unlink(missing_ok=True)
