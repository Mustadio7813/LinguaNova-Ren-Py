+def LN_src_tools_game_optimizer__copy_entry(f, off, length, prefix, out):
+    out.parent.mkdir(parents=True, exist_ok=True)
+    tmp = out.with_name(out.name + '.tmp_rpa')
+    try:
+        with open(tmp, 'wb') as w:
+            w.write(prefix)
+            f.seek(off)
+            left = length - len(prefix)
+            while left > 0:
+                block = f.read(min(1 << 20, left))
+                if not block:
+                    raise ValueError('lectura incompleta')
+                w.write(block)
+                left -= len(block)
+        LN_src_tools_game_optimizer__os.replace(tmp, out)
+    finally:
+        tmp.unlink(missing_ok=True)
+
