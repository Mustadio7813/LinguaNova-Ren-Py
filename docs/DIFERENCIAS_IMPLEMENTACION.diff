+def LN_src_tools_game_optimizer__webp_kind(data):
+    """'lossless', 'lossy' or 'animada', read from the RIFF chunks."""
+    if data[:4] != b'RIFF' or data[8:12] != b'WEBP':
+        return None
+    i = 12
+    while i + 8 <= len(data):
+        fourcc = data[i:i + 4]
+        n = int.from_bytes(data[i + 4:i + 8], 'little')
+        if fourcc == b'ANIM':
+            return 'animada'
+        if fourcc == b'VP8L':
+            return 'lossless'
+        if fourcc == b'VP8 ':
+            return 'lossy'
+        i += 8 + n + (n & 1)
+    return None
+
