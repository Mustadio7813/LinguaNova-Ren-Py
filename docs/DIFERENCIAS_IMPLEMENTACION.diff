+            block = r.read(1 << 20)
+            if not block:
+                break
+            w.write(block)
+            digest.update(block)
+            done += len(block)
+            progress(done, total)
+    if digest.hexdigest().lower() != expected_sha.lower():
+        raise LN_src_tools_game_optimizer__OptimizerError('La descarga no coincide con la huella SHA-256 publicada; se descartó.')
