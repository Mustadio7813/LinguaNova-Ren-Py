+# ==============================================================================
+# INICIO: Acción de soporte ensure_optional
+# FUNCIÓN: Instala las librerías opcionales de imagen sin impedir el arranque.
+# Solo paquetes ya compilados (--only-binary), con pocos reintentos, y como mucho
+# un intento al día cuando falla (sin Internet, o un Python sin paquetes).
+# ==============================================================================
+def LN_start__ensure_optional(python, log, environment):
+    import time
+    if LN_start__works(python, LN_OPTIONAL_IMPORTS):
+        return
+    state_file = LN_start__Path(environment) / 'linguanova-optional.json'
+    wanted = LN_start__hashlib.sha256(LN_start__json.dumps(LN_OPTIONAL_DEPENDENCIES).encode('utf-8')).hexdigest()
+    try:
+        state = LN_start__json.loads(state_file.read_text(encoding='utf-8'))
+    except (OSError, ValueError):
+        state = {}
+    if state.get('fingerprint') == wanted and time.time() - float(state.get('tried', 0)) < 86400:
+        return
+    print('Instalando las librerías de imagen de «Aligerar el juego» (opcionales)…', flush=True)
+    install = [str(python), '-m', 'pip', 'install', '--only-binary', ':all:', '--retries', '1', '--default-timeout', '20']
+    try:
+        LN_start__checked(install + LN_OPTIONAL_DEPENDENCIES, log)
+    except RuntimeError:
+        for requirement in LN_OPTIONAL_DEPENDENCIES:
+            try:
+                LN_start__checked(install + [requirement], log)
+            except RuntimeError:
+                pass
+    state_file.write_text(LN_start__json.dumps({'fingerprint': wanted, 'tried': time.time()}), encoding='utf-8')
+# ==============================================================================
+# FIN: Acción de soporte ensure_optional
 # ==============================================================================
 
