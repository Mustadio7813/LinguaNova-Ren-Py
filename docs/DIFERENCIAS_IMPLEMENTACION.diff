+def LN_src_tools_game_optimizer__default_output(root, parent=None):
+    """<parent>/<game>_Optimizado; a numbered name when that one is taken by other files."""
+    root = LN_src_tools_game_optimizer__Path(root)
+    parent = LN_src_tools_game_optimizer__Path(parent) if parent else root.parent
+    candidate = parent / f'{root.name}_Optimizado'
+    n = 2
+    while LN_src_tools_game_optimizer__output_problem(candidate, root):
+        candidate = parent / f'{root.name}_Optimizado_{n}'
+        n += 1
+        if n > 99:
+            break
+    return candidate
