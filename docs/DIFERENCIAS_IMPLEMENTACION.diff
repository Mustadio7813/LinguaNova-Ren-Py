+def LN_src_tools_game_optimizer__read_rpa_index(rpa):
+    with open(rpa, 'rb') as f:
+        header = f.readline(300).decode('latin-1').strip()
+        header_end = f.tell()
+        parts = header.split()
+        if not parts:
+            raise ValueError('cabecera vacía')
+        version = parts[0]
+        if version.startswith('RPA-2'):
+            offset, key = int(parts[1], 16), 0
+        elif version.startswith('RPA-3'):
+            offset, key = int(parts[1], 16), 0
+            for sub in parts[3 if version.startswith('RPA-3.2') else 2:]:
+                key ^= int(sub, 16)
+        else:
+            raise ValueError(f'formato no soportado: {version}')
+        f.seek(offset)
+        index = LN_src_tools_game_optimizer__SafeUnpickler(LN_src_tools_game_optimizer__io.BytesIO(LN_src_tools_game_optimizer__zlib.decompress(f.read())), encoding='bytes').load()
+    entries = []
+    for name, segments in index.items():
+        if not segments:
+            continue
+        if len(segments) != 1:
+            raise ValueError('entrada con varios segmentos (no soportado)')
+        e = segments[0]
+        off, length = int(e[0]) ^ key, int(e[1]) ^ key
+        prefix = LN_src_tools_game_optimizer___as_bytes(e[2]) if len(e) > 2 else b''
+        if length < len(prefix) or off < header_end or off + length - len(prefix) > offset:
+            raise ValueError(f'segmento fuera del área de datos: {LN_src_tools_game_optimizer___as_text(name)}')
+        entries.append((LN_src_tools_game_optimizer___as_text(name), off, length, prefix))
+    return entries
+
